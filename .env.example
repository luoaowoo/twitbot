# ── Telegram ──────────────────────────────────────────────
# @BotFather -> /newbot 拿 token
# 【可留空】—— python start.py 会照常启动 Web 与发布循环；
# 之后在 Web 控制台的「Telegram 机器人」面板里填 token 点「启动机器人」即可，
# 不用改这个文件、不用重启。（这里填了的话，控制台留空就沿用这里的）
TG_TOKEN=
# 允许发料的人（Telegram user id，逗号分隔）；留空=不限制发送者
# 拿 id：给 @userinfobot 发一条消息
# 也可在 Web 控制台里改，以控制台设置为准
ALLOWED_USERS=
# 允许的会话（频道/群的 chat_id，负数，逗号分隔）；留空=不限制来源
ALLOWED_CHATS=

# ── X (Twitter) 官方 API 凭据 ─────────────────────────────
# developer.x.com -> Projects & Apps -> Keys and tokens
# 重要：App permissions 必须先设成 Read and Write，再重新生成 Access Token
# 用 python setup_x.py 可引导你自动拿到这四项
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ── 发布后端选择 ──────────────────────────────────────────
# x_api   = X 官方 API（稳定合规，需要开发者账号与额度）
# browser = 无头浏览器（不耗 API 额度，用登录态模拟真人操作）
# 运行期可在 Web 控制台随时切换，以控制台设置为准
BACKEND=x_api

# 浏览器后端：false 会弹出浏览器窗口，便于首次登录与排障
BROWSER_HEADLESS=true
# 浏览器操作放慢毫秒数（0=不放慢；排障可设 300）
BROWSER_SLOWMO=0

# ── Web 控制台 ────────────────────────────────────────────
WEB_HOST=127.0.0.1
WEB_PORT=8787
# 非空则访问控制台需要 token：?token=xxx 或 Authorization: Bearer xxx
# 控制台能直接发推，暴露到公网前务必设置
WEB_TOKEN=

# ── 控制台管理密码（服务器版专属）─────────────────────────
# 访问控制台会先要求输入这个密码，登录后凭会话 Cookie 访问（密码不再出现在 URL）。
# 留空 = 首次启动自动生成随机密码（见 data/console-password）
# 设为单独的 - = 关闭密码门（仅供内网/测试，公网切勿这么做）
WEB_PASSWORD=

# ── 行为 ──────────────────────────────────────────────────
# auto = 收到就发；confirm = 先回预览，点✅才发（推荐先跑 confirm）
MODE=confirm
# 每条推文自动加的前后缀（留空则不加）
TWEET_PREFIX=
TWEET_SUFFIX=
# 内容里带推文链接时是否自动转引用转发（quote tweet）
QUOTE_MODE=auto
# 秒：同内容去重窗口
DEDUP_WINDOW=600
# 月度发推软上限（X 免费层额度很紧，留余量）
MONTHLY_LIMIT=480
# 单条最多重试次数
MAX_ATTEMPTS=5
# 队列轮询间隔（秒）
POLL_SECONDS=2
# 数据目录（默认 ./data）
DATA_DIR=
